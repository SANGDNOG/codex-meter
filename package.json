{
  "name": "codex-meter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Privacy-preserving multi-device Codex usage meter with a legacy V1 mode",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SANGDNOG/codex-meter.git"
  },
  "bugs": {
    "url": "https://github.com/SANGDNOG/codex-meter/issues"
  },
  "homepage": "https://github.com/SANGDNOG/codex-meter#readme",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "server": "node bin/server.js",
    "admin": "node bin/admin.js",
    "codex-meter": "node bin/codex-meter.js",
    "v2-agent": "node bin/v2-agent.js",
    "v2-server": "node bin/v2-server.js",
    "test": "node --test --test-concurrency=1",
    "test:v1": "node --test --test-concurrency=1 test/meter.test.js test/phase0.test.js test/phase0-app-update.test.js test/phase0-rollout-update.test.js",
    "test:v2": "node --test --test-concurrency=1 test/v2-*.test.js",
    "check:syntax": "node scripts/check-syntax.js",
    "package:v2-agent": "node scripts/package-v2-agent.js",
    "release:v2-manifest": "node scripts/release-v2-manifest.js"
  },
  "devDependencies": {
    "esbuild": "0.25.9",
    "postject": "1.0.0-alpha.6"
  }
}
